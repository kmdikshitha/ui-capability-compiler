# Required for `discover` only. `replay` never reads either of these.
ANTHROPIC_API_KEY=

# Optional: route the Anthropic SDK through a gateway that speaks the Messages
# API. For OpenRouter, set the key to your sk-or-... token and uncomment this,
# then pass a namespaced model, e.g. --model anthropic/claude-sonnet-5
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
